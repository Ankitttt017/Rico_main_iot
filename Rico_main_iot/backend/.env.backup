NODE_ENV=development
PORT=5000

DB_HOST=192.168.100.137
DB_PORT=1433
DB_NAME=IOT_Trace
DB_USER=Bawal
DB_PASSWORD=Bawal@123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_TRUSTED_CONNECTION=false
DB_AUTO_MIGRATE=false

DB_CONNECT_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=120000
DB_QUERY_TIMEOUT=300000
DB_SCHEMA_QUERY_TIMEOUT=300000

PLC_MONITOR_ENABLED=true

PLC_UBE_SHOT_CHANGE_FALLBACK_ENABLED=true
PLC_UBE_SAVE_ON_LIVE_SHOT_CHANGE=false
PLC_UBE_SHOT_CHANGE_SAVE_ENABLED=false

PLC_LEAK_CYCLE_START_DEVICE=
PLC_LEAK_CYCLE_END_DEVICE=M300
PLC_PLANT_ENVIRONMENT_PORT=5002

# UBE Dedicated Socket for Bit Polling
PLC_UBE_ENABLE_DEDICATED_SOCKET=true
